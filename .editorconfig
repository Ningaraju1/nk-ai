# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# 2 space indentation
[*.{json,yml,yaml,md,html,js,ts,jsx,tsx,css,scss}]
indent_size = 2

# Python specific
[*.py]
indent_style = space
indent_size = 4

# Makefiles always use tabs for indentation
[Makefile]
indent_style = tab

# Markdown files often have trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false
